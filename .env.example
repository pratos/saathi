# Optional server-side Convex deployment variables. Set these with
# `npx convex env set`; never expose them through VITE_ variables.
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
# Deployment-funded credentials for approved managed accounts.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Managed structured decisions only; BYOK families use their OpenRouter key.
TYPESAFE_API_KEY=
# Required before storing BYOK credentials. Generate with: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=
# Comma-separated; these accounts can approve deployment-funded access.
SUPERADMIN_EMAILS=prathamesh.b.sarang@gmail.com
# Optional reviewer login for /?mode=live&admin=access. Set both only in the
# Convex deployment. Hash the lowercase email and code as documented in README.
ADMIN_REVIEW_EMAIL=
ADMIN_REVIEW_CODE_SHA256=
JEV_VOICE_BROWSER_ENABLED=false
